# --- MongoDB ---
# Local install:  mongodb://localhost:27017
# Atlas:          mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=hotel_billing

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- First admin, created only when the users collection has no admin ---
BOOTSTRAP_ADMIN_NAME=Super Admin
BOOTSTRAP_ADMIN_EMAIL=admin@myhotel.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@123

# Set to false once all staff accounts are created by the admin panel
ALLOW_PUBLIC_STAFF_REGISTRATION=true

DEBUG=true
