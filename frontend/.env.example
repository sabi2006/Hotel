# Leave unset in local development: vite.config.ts proxies /api to http://localhost:8000
# Set these when deploying the frontend to Vercel (pointing to your deployed backend):

# Backend API URL (e.g. Render, Railway, VPS)
VITE_API_URL=https://your-backend-service.onrender.com/api

# Realtime WebSocket URL (wss:// for HTTPS backend)
VITE_WS_URL=wss://your-backend-service.onrender.com/ws
